<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>XkScreen.Gui</AssemblyName>
    <RootNamespace>XkScreen.Gui</RootNamespace>
    <Version>0.4.1</Version>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <!-- Real version metadata matters: a freshly built, unsigned assembly with the
         SDK's placeholder company/product text ("XkScreen.Gui") is exactly what
         heuristic AV engines (e.g. 360's QVM) score as suspicious. -->
    <Company>Arimayuki03</Company>
    <Product>XkScreen</Product>
    <AssemblyTitle>XkScreen 屏幕控制台</AssemblyTitle>
    <Description>XkScreen 星璨小岚机箱小屏控制台 (XK003)</Description>
    <Copyright>Copyright (c) 2026 Arimayuki03. MIT License.</Copyright>
    <InformationalVersion>0.4.1 (https://github.com/Arimayuki03/xkscreen)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="appicon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- Copy the built Next.js static export (frontend/out) into the app's web/ folder -->
  <Target Name="CopyFrontend" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\..\frontend\out')">
    <RemoveDir Directories="$(OutDir)web" />
    <ItemGroup>
      <FrontendFiles Include="$(MSBuildProjectDirectory)\..\frontend\out\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendFiles)" DestinationFiles="@(FrontendFiles->'$(OutDir)web\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
